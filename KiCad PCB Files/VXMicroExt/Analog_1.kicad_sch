	(text_box "High range Iref : \n(39/859) * Vsupply / 166R8 -> (39/(859*166.8)) * Vsupply\n\nLow range Iref : \n(39/859) * Vsupply / 16.247 -> (39/(859*16.247)) * Vsupply\n\nAssuming Rload, observed Vload : \n\nVload = Rload * Iref\n\nRload = (Vload/Vsupply) * Kfactor\nLow range : Kfactor = 859 * 16.247 / 39\nHi range : Kfactor = 859 * 166.8 / 39\n"
		(exclude_from_sim no)
		(at 96.52 210.82 0)
