	(text "10kOhm for diode protection\nForms a RC filter\nCut-off frequency : \n- For 1nF -> 16kHz\n- For 10nF -> 1.6kHz\n\n1nF and below seems preferable to avoid distortion "
		(exclude_from_sim no)
		(at 56.896 168.148 0)
